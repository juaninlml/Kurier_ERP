// Kurier ERP — Fase 1: Cotizaciones, Facturas (informativas) y Contabilidad básica
// PostgreSQL (Prisma Postgres en Vercel). DATABASE_URL viene de las variables de entorno.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Configuración única de la empresa (id = 1). Alimenta el branding de los PDFs.
model CompanySettings {
  id                Int       @id @default(1)
  tradeName         String    @default("Kurier Fulfillment")
  tagline           String    @default("MICROHUB CDMX · 3PL")
  legalName         String    @default("")
  rfc               String    @default("")
  address           String    @default("")
  city              String    @default("")
  state             String    @default("")
  zip               String    @default("")
  phone             String    @default("")
  email             String    @default("")
  website           String    @default("")
  bankName          String    @default("")
  bankAccount       String    @default("")
  clabe             String    @default("")
  primaryColor      String    @default("#1F4E79")
  accentColor       String    @default("#ED7D31")
  logoPath          String    @default("/branding/logo.png") // respaldo: archivo en /public
  logoData          Bytes? // logo subido desde Configuración (se guarda en BD; Vercel no permite escribir en disco)
  logoMime          String    @default("")
  quotePrefix       String    @default("COT")
  invoicePrefix     String    @default("FAC")
  nextQuoteNumber   Int       @default(1)
  nextInvoiceNumber Int       @default(1)
  defaultTaxRate    Float     @default(16)
  quoteValidityDays Int       @default(15)
  paymentTermsDays  Int       @default(30)
  quoteTerms        String    @default("")
  invoiceNotes      String    @default("")
  paymentTerms      String    @default("Pago contra recepción de factura a 8 días naturales.")
  invoiceDisclaimer String    @default("")
  tariffIntro       String    @default("") // párrafo bajo el título del PDF del tarifario
  tariffTerms       String    @default("") // condiciones comerciales del tarifario (una por línea)
  tariffClosing     String    @default("") // recuadro final del tarifario
  // Punto de equilibrio (Contabilidad → Gastos fijos)
  beOrderRate       Float     @default(45) // tarifa promedio por orden (sin IVA)
  beShippingCost    Float     @default(70) // costo promedio de la guía de envío
  beShippingMarkup  Float     @default(20) // % de markup sobre la guía
  beGuideShare      Float     @default(100) // % de órdenes con guía generada por Kurier
  beVariableCost    Float     @default(0) // costo variable por orden (empaque, etiqueta…)
  beSystemFee       Float     @default(500) // cobro mensual de sistema por cliente
  beClients         Int       @default(0) // clientes que pagan sistema (0 = clientes activos)
  beWorkingDays     Float     @default(26) // días operativos al mes
  beIncludePayroll  Boolean   @default(true) // sumar la nómina de los empleados activos
  // Tipo de cambio de referencia para facturas en yuanes (CNY)
  cnyRate           Float     @default(0) // MXN por 1 CNY (Frankfurter / Banco Central Europeo)
  cnyRateDate       String    @default("") // fecha de publicación de ese tipo de cambio (yyyy-mm-dd)
  cnyRateAt         DateTime? // cuándo se consultó; se renueva cada sábado a las 7:00 a. m.
  // Asistencia (kiosco)
  timezone          String    @default("America/Mexico_City")
  lateToleranceMin  Int       @default(10) // minutos de tolerancia para retardo
  autoCloseMin      Int       @default(5) // minutos después de la salida en que se registra la salida automática
  overtimeRate      Float     @default(2) // las horas extra se pagan al doble del salario por hora
  updatedAt         DateTime  @updatedAt
}

model Client {
  id            Int           @id @default(autoincrement())
  name          String
  legalName     String        @default("")
  rfc           String        @default("")
  contactName   String        @default("")
  email         String        @default("")
  phone         String        @default("")
  address       String        @default("")
  notes         String        @default("")
  wmsName       String        @default("") // nombre del cliente tal como aparece en el WMS (ej. "Basic&Pure")
  orderRate     Float         @default(0) // tarifa por paquete del servicio logístico (órdenes diarias); 0 = usar la tarifa negociada que coincida
  brandId       Int? // marca que le factura (vacío = la principal)
  brand         Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  quotes        Quote[]
  invoices      Invoice[]
  transactions  Transaction[]
  rates         ClientRate[]
  wmsImports    WmsImport[]
  dailySupplies DailySupply[]
  dailyOrders   DailyOrder[]
  shipments     Shipment[]
  goodsExits    GoodsExit[]
}

/// Proveedor de Kurier (renta, insumos de empaque, paquetería, servicios…). Los egresos de contabilidad se ligan a él.
model Supplier {
  id            Int            @id @default(autoincrement())
  name          String
  legalName     String         @default("")
  rfc           String         @default("")
  category      String         @default("") // giro: Insumos, Renta, Paquetería, Servicios…
  contactName   String         @default("")
  email         String         @default("")
  phone         String         @default("")
  address       String         @default("")
  website       String         @default("")
  creditDays    Int            @default(0) // días de crédito que da el proveedor (0 = contado)
  bank          String         @default("")
  clabe         String         @default("")
  accountNumber String         @default("")
  notes         String         @default("")
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  transactions  Transaction[]
  bills         SupplierBill[]
}

/// Cuenta por pagar: factura o recibo que un proveedor le cobra a Kurier.
/// status: PENDIENTE | PARCIAL | PAGADA | CANCELADA ("VENCIDA" se calcula al mostrar: abierta y con fecha de pago pasada).
model SupplierBill {
  id         Int               @id @default(autoincrement())
  supplierId Int
  supplier   Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  folio      String            @default("") // folio de la factura del proveedor
  concept    String
  category   String // categoría de egreso con la que se registran sus pagos
  issueDate  DateTime
  dueDate    DateTime
  total      Float // con IVA
  tax        Float             @default(0) // IVA incluido en el total
  paidTotal  Float             @default(0)
  status     String            @default("PENDIENTE")
  notes      String            @default("")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  payments   SupplierPayment[]

  @@index([supplierId])
  @@index([status, dueDate])
}

/// Pago (total o parcial) de una cuenta por pagar. Cada pago genera su egreso en contabilidad.
model SupplierPayment {
  id          Int          @id @default(autoincrement())
  billId      Int
  bill        SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount      Float
  date        DateTime
  method      String       @default("Transferencia")
  reference   String       @default("")
  notes       String       @default("")
  createdAt   DateTime     @default(now())
  transaction Transaction?

  @@index([billId])
}

/// Tarifa negociada con un cliente. Al importar movimientos del WMS se busca por wmsConcept.
model ClientRate {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code        String   @default("")
  name        String // como aparece en la factura
  description String   @default("")
  wmsConcept  String   @default("") // concepto del WMS que corresponde (ej. "Procesamiento de pedido")
  unit        String   @default("Servicio")
  unitPrice   Float    @default(0)
  priceText   String   @default("")
  atCost      Boolean  @default(false) // se factura al importe que reporta el WMS (fletes)
  taxRate     Float    @default(16)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

/// Estado de cobro recibido del WMS (PDF o API). Se revisa y luego se convierte en factura.
/// status: PENDIENTE | FACTURADO | DESCARTADO
model WmsImport {
  id          Int       @id @default(autoincrement())
  folio       String    @unique // folio del WMS (ej. COB-2026-10-19-0006)
  source      String    @default("pdf") // pdf | api
  clientName  String    @default("")
  clientId    Int?
  client      Client?   @relation(fields: [clientId], references: [id])
  periodLabel String    @default("")
  periodFrom  DateTime?
  periodTo    DateTime?
  issuedAt    DateTime?
  payload     String    @default("{}") // JSON con los movimientos (WmsStatement)
  subtotal    Float     @default(0)
  tax         Float     @default(0)
  total       Float     @default(0)
  status      String    @default("PENDIENTE")
  invoiceId   Int?      @unique
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Catálogo de servicios de fulfillment (almacenaje, pick & pack, envíos, etc.)
model Service {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String   @default("")
  unit        String   @default("Servicio")
  unitPrice   Float    @default(0)
  taxRate     Float    @default(16)
  section     String   @default("") // sección del tarifario (Almacenamiento, Fulfillment…)
  priceText   String   @default("") // tarifa en texto cuando no es un precio simple ("Gratis", "A cotizar"…)
  atCost      Boolean  @default(false) // se factura al costo (ej. guía de envío): el importe se captura directo
  wmsConcept  String   @default("") // concepto del WMS para la tarifa estándar
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Secciones del tarifario, con la nota que se imprime debajo de cada tabla en la cotización.
model ServiceSection {
  id        Int    @id @default(autoincrement())
  name      String @unique
  note      String @default("")
  sortOrder Int    @default(0)
}

/// status: BORRADOR | ENVIADA | ACEPTADA | RECHAZADA | FACTURADA
model Quote {
  id                Int         @id @default(autoincrement())
  folio             String      @unique
  clientId          Int? // vacío mientras sea prospecto; se llena al aceptar la propuesta
  client            Client?     @relation(fields: [clientId], references: [id])
  brandId           Int?
  brand             Brand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)
  // Prospecto (propuesta comercial a una empresa que todavía no es cliente)
  prospectName      String      @default("")
  prospectLegalName String      @default("")
  prospectRfc       String      @default("")
  prospectEmail     String      @default("")
  prospectPhone     String      @default("")
  acceptedAt        DateTime? // al aceptarse se crea el cliente y se cargan sus tarifas
  issueDate         DateTime    @default(now())
  validUntil        DateTime
  status            String      @default("BORRADOR")
  attention         String      @default("")
  profile           String      @default("[]") // JSON: [{ label, value }] — "Perfil de la operación cotizada"
  notes             String      @default("")
  terms             String      @default("")
  perOrder          String      @default("[]") // JSON: [{ label, amount }] — tabla "Costo por pedido"
  perOrderFee       Float       @default(0) // comisión de guía que se suma en la 2a columna ("Con guía de Kurier")
  baseVolume        Float       @default(0) // pedidos que representa el costo estimado
  scenarios         String      @default("") // volúmenes a comparar: "250, 500, 1000"
  subtotal          Float       @default(0)
  discount          Float       @default(0)
  tax               Float       @default(0)
  total             Float       @default(0)
  items             QuoteItem[]
  invoices          Invoice[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Índices para listas, tablero y reportes (0022)
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id          Int     @id @default(autoincrement())
  quoteId     Int
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position    Int     @default(0)
  code        String  @default("")
  description String
  detail      String  @default("") // descripción detallada (columna "Descripción" de la cotización)
  section     String  @default("")
  priceText   String  @default("")
  atCost      Boolean @default(false)
  scales      Boolean @default(false) // escenarios por volumen: la cantidad crece en proporción
  unit        String  @default("Servicio")
  quantity    Float
  unitPrice   Float
  discountPct Float   @default(0)
  taxRate     Float   @default(16)
  amount      Float   @default(0) // importe sin IVA, después de descuento

  // Índices para listas, tablero y reportes (0022)
  @@index([quoteId])
}

/// status: PENDIENTE | PARCIAL | PAGADA | CANCELADA
model Invoice {
  id           Int           @id @default(autoincrement())
  folio        String        @unique
  clientId     Int
  client       Client        @relation(fields: [clientId], references: [id])
  quoteId      Int?
  quote        Quote?        @relation(fields: [quoteId], references: [id])
  issueDate    DateTime      @default(now())
  dueDate      DateTime
  status       String        @default("PENDIENTE")
  period       String        @default("") // "15 al 22 de agosto de 2026 — ciclo semanal"
  volume       String        @default("") // "39 pedidos, todos bajo la tarifa Orden Ligera"
  storage      String        @default("") // "No se cobra en este periodo."
  terms        String        @default("") // condiciones de pago
  notes        String        @default("")
  subtotal     Float         @default(0)
  discount     Float         @default(0)
  tax          Float         @default(0)
  total        Float         @default(0)
  paidTotal    Float         @default(0)
  currency     String        @default("MXN") // MXN o CNY (yuan/renminbi); importes, pagos y saldo en esta moneda
  exchangeRate Float         @default(1) // MXN por 1 unidad de la moneda (1 en MXN); contabilidad y reportes suman en MXN
  ordersWeek   String        @default("") // lunes (yyyy-mm-dd) de la semana de órdenes diarias facturada como servicio logístico
  items        InvoiceItem[]
  payments     Payment[]
  wmsImport    WmsImport?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  brand        Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId      Int?

  // Índices para listas, tablero y reportes (0022)
  @@index([clientId])
  @@index([status, dueDate])
  @@index([createdAt])
  // Índices (0036)
  @@index([issueDate])
  @@index([ordersWeek])
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int     @default(0)
  code        String  @default("")
  description String
  detail      String  @default("") // descripción detallada (columna "Descripción" de la cotización)
  section     String  @default("")
  priceText   String  @default("")
  atCost      Boolean @default(false)
  scales      Boolean @default(false) // escenarios por volumen: la cantidad crece en proporción
  unit        String  @default("Servicio")
  quantity    Float
  unitPrice   Float
  discountPct Float   @default(0)
  taxRate     Float   @default(16)
  amount      Float   @default(0)

  // Índices para listas, tablero y reportes (0022)
  @@index([invoiceId])
}

/// Pago recibido de una factura. Genera automáticamente un movimiento de INGRESO.
model Payment {
  id          Int          @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date        DateTime     @default(now())
  amount      Float
  method      String       @default("Transferencia")
  reference   String       @default("")
  notes       String       @default("")
  transaction Transaction?
  createdAt   DateTime     @default(now())

  // Índices para listas, tablero y reportes (0022)
  @@index([invoiceId])
  @@index([createdAt])
}

/// Movimiento contable. type: INGRESO | EGRESO
model Transaction {
  id                Int              @id @default(autoincrement())
  date              DateTime         @default(now())
  type              String
  category          String
  description       String           @default("")
  amount            Float // monto total (con IVA)
  tax               Float            @default(0) // IVA incluido en el monto
  method            String           @default("Transferencia")
  reference         String           @default("")
  clientId          Int? // ingresos: cliente que pagó
  client            Client?          @relation(fields: [clientId], references: [id])
  supplierId        Int? // egresos: proveedor al que se pagó
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  paymentId         Int?             @unique
  payment           Payment?         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  supplierPaymentId Int?             @unique // egresos: pago de una cuenta por pagar
  supplierPayment   SupplierPayment? @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  bankLine          BankLine? // renglón del estado de cuenta con el que se concilió
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([supplierId])
  // Índices para listas, tablero y reportes (0022)
  @@index([date])
  @@index([clientId])
  @@index([createdAt])
}

/// Tablas informativas del tarifario (Incluido en todos los planes, SLA, cobertura…).
/// columns: "Concepto|Detalle" (opcional "Título:30" = ancho %); rows: una fila por línea, celdas separadas por |
model TariffTable {
  id           Int     @id @default(autoincrement())
  title        String
  afterSection String  @default("") // se imprime después de esta sección del tarifario (vacío = al final)
  columns      String  @default("Concepto|Detalle")
  rows         String  @default("")
  note         String  @default("")
  inQuotes     Boolean @default(false) // también se imprime en las cotizaciones
  sortOrder    Int     @default(0)
}

/// Gasto fijo recurrente (renta, nómina externa, insumos, servicios…). frequency: SEMANAL | QUINCENAL | MENSUAL | BIMESTRAL | ANUAL
model FixedExpense {
  id        Int      @id @default(autoincrement())
  name      String
  category  String   @default("Otros")
  amount    Float
  frequency String   @default("MENSUAL")
  active    Boolean  @default(true)
  notes     String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Empleado. Las prestaciones (vacaciones, prima vacacional, aguinaldo) se calculan según la LFT a partir de startDate y el salario diario.
model Employee {
  id                 Int            @id @default(autoincrement())
  name               String
  position           String         @default("")
  area               String         @default("") // Almacén, Administración… (se copia del puesto)
  department         String         @default("") // Picking, Packing… (se copia del puesto)
  jobPositionId      Int?
  jobPosition        JobPosition?   @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  rfc                String         @default("")
  curp               String         @default("")
  nss                String         @default("")
  phone              String         @default("")
  email              String         @default("")
  address            String         @default("")
  bankName           String         @default("")
  clabe              String         @default("")
  startDate          DateTime // fecha de ingreso (antigüedad)
  endDate            DateTime? // fecha de baja
  weeklySalary       Float          @default(0) // salario semanal (base del cálculo)
  workDays           Int            @default(6) // días laborables por semana: 6 (descansa domingo) o 5 (descansa fin de semana)
  hoursPerDay        Float          @default(8) // jornada diaria, para el salario por hora
  dailySalary        Float // salario diario = semanal ÷ días laborables (se calcula al guardar)
  weeklyBonus        Float          @default(0) // bono fijo semanal (puntualidad, asistencia…)
  scheduleStart      String         @default("09:00") // hora de entrada
  scheduleEnd        String         @default("18:00") // hora de salida
  mealStart          String         @default("14:00") // inicio del horario de comida
  mealEnd            String         @default("15:00") // fin del horario de comida
  kioskSecret        String         @default("") // autenticador del kiosco (cifrado)
  kioskPendingSecret String         @default("") // QR mostrado, pendiente de confirmar
  kioskLastStep      Int            @default(0)
  active             Boolean        @default(true)
  notes              String         @default("")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  payrollLines       PayrollLine[]
  punches            Punch[]
  overtimeAuths      OvertimeAuth[]
  incidents          Incident[]
}

/// Catálogo de puestos: cada puesto pertenece a un departamento dentro de un área (ej. Almacén › Picking › Auxiliar picking).
model JobPosition {
  id         Int        @id @default(autoincrement())
  area       String
  department String     @default("")
  name       String
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  employees  Employee[]
}

/// Nómina de un periodo (semanal). status: BORRADOR → APROBADA (solo se pagan los netos, empleado por empleado) → PAGADA.
/// Al quedar pagados todos los empleados pasa a PAGADA y genera un EGRESO en contabilidad.
model PayrollRun {
  id            Int           @id @default(autoincrement())
  periodStart   DateTime
  periodEnd     DateTime
  payDate       DateTime
  status        String        @default("BORRADOR")
  approvedAt    DateTime?
  approvedBy    String        @default("")
  notes         String        @default("")
  total         Float         @default(0)
  transactionId Int?          @unique
  brandId       Int? // marca que paga la nómina (vacío = la principal)
  brand         Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  lines         PayrollLine[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PayrollLine {
  id              Int        @id @default(autoincrement())
  runId           Int
  run             PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId      Int
  employee        Employee   @relation(fields: [employeeId], references: [id])
  weeklySalary    Float      @default(0) // salario semanal al momento de la nómina
  workDays        Int        @default(6) // jornada de la semana: 5 o 6 días
  hoursPerDay     Float      @default(8)
  dailySalary     Float // salario diario = semanal ÷ días laborables
  days            Float      @default(6) // días pagados (6 por semana; el 7º es descanso)
  absences        Float      @default(0) // faltas injustificadas (se descuentan a salario diario)
  vacationDays    Float      @default(0) // días de vacaciones tomados (pagados dentro de los días + prima vacacional)
  vacationPremium Float      @default(0)
  overtimeHours   Float      @default(0) // horas extra trabajadas
  overtime        Float      @default(0) // importe de horas extra = horas × salario por hora × tarifa de horas extra
  bonus           Float      @default(0)
  bonusNote       String     @default("") // motivo del bono
  aguinaldo       Float      @default(0)
  otherIncome     Float      @default(0)
  deductions      Float      @default(0) // préstamos, anticipos, faltantes…
  deductionNote   String     @default("") // motivo del descuento
  leaveDays       Float      @default(0) // permisos sin goce de sueldo (se descuentan, pero no son faltas injustificadas)
  absenceNote     String     @default("") // detalle de faltas y permisos de la semana (sale en el recibo)
  notice          String     @default("") // aviso en el recibo (ej. descanso por retardos la próxima semana)
  payMethod       String     @default("") // TRANSFERENCIA | EFECTIVO (vacío = transferencia si tiene CLABE, si no efectivo)
  paidAt          DateTime? // cuándo se marcó como pagado este empleado
  paidBy          String     @default("") // quién lo marcó
  notes           String     @default("")
  gross           Float      @default(0)
  net             Float      @default(0)

  @@index([employeeId])
  // Índices (0036)
  @@index([runId])
}

/// Usuario del ERP (inicia sesión con correo + código de su app autenticadora). role: OWNER (cuenta maestra) | ADMIN | USER
model User {
  id                Int          @id @default(autoincrement())
  email             String       @unique
  name              String       @default("")
  image             String       @default("")
  role              String       @default("USER")
  active            Boolean      @default(true)
  locale            String       @default("es") // es | en | zh
  position          String       @default("") // puesto (perfil)
  phone             String       @default("")
  lastLoginAt       DateTime?
  lastSeenChangelog String       @default("") // id de la última novedad vista (src/lib/changelog.ts)
  totpSecret        String       @default("") // secreto del autenticador (cifrado)
  totpLastStep      Int          @default(0) // último código usado (evita reutilizarlo)
  failedLogins      Int          @default(0)
  lockedUntil       DateTime?
  invitedById       Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  invitationsSent   Invitation[] @relation("InvitationCreator")
}

/// Link para vincular el autenticador. kind: INVITE (alta) | RESET (cambio de teléfono) | OWNER (cuenta maestra).
model Invitation {
  id            Int       @id @default(autoincrement())
  token         String    @unique
  email         String    @default("")
  role          String    @default("USER")
  kind          String    @default("INVITE")
  name          String    @default("") // nombre capturado al aceptar
  pendingSecret String    @default("") // secreto del QR mientras se confirma (cifrado)
  note          String    @default("")
  expiresAt     DateTime
  usedAt        DateTime?
  usedByEmail   String    @default("")
  revokedAt     DateTime?
  createdById   Int?
  createdBy     User?     @relation("InvitationCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
}

/// Tablet autorizada como kiosco de asistencia (la cookie del dispositivo guarda el token; aquí solo su hash).
model KioskDevice {
  id              Int       @id @default(autoincrement())
  name            String
  tokenHash       String    @unique // hash del token guardado en la cookie de la tablet
  activationToken String    @default("") // link de un solo uso para autorizar la tablet
  active          Boolean   @default(true)
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  punches         Punch[]
}

/// Checada. type: ENTRADA | SALIDA_COMIDA | REGRESO_COMIDA | SALIDA. source: KIOSCO | AUTO | MANUAL
model Punch {
  id          Int          @id @default(autoincrement())
  employeeId  Int
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String
  at          DateTime
  workDate    String // AAAA-MM-DD en hora local
  source      String       @default("KIOSCO")
  deviceId    Int?
  device      KioskDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  note        String       @default("")
  createdById Int?
  deleted     Boolean      @default(false) // las correcciones no borran: marcan
  createdAt   DateTime     @default(now())

  @@index([employeeId, workDate])
  // Índice (0036): la salida automática del kiosco filtra solo por fecha, cada minuto
  @@index([workDate])
}

/// Incidencia de un empleado (fechas AAAA-MM-DD, solo cuentan sus días laborables).
/// type: FALTA (injustificada) | PERMISO (falta justificada, con o sin goce) | VACACIONES | DESCANSO_RETARDOS (3 retardos en el mes).
/// status: PENDIENTE | AUTORIZADA | RECHAZADA. source: MANUAL | KIOSCO (falta detectada sin checada) | AUTO (regla de retardos).
model Incident {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String
  startDate  String
  endDate    String
  days       Float     @default(1)
  withPay    Boolean   @default(false)
  status     String    @default("AUTORIZADA")
  reason     String    @default("")
  source     String    @default("MANUAL")
  monthKey   String    @default("") // AAAA-MM del acumulado de retardos
  lateDates  String    @default("") // fechas de los retardos que generaron el descanso (separadas por coma)
  decidedAt  DateTime?
  decidedBy  String    @default("") // quién autorizó o rechazó
  createdBy  String    @default("")
  createdAt  DateTime  @default(now())

  @@index([employeeId, startDate])
}

/// Horas extra autorizadas para un día: el empleado puede quedarse hasta `until` (HH:MM).
model OvertimeAuth {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate     String
  until        String
  note         String   @default("")
  approvedById Int?
  createdAt    DateTime @default(now())

  @@unique([employeeId, workDate])
}

/// Oleada de surtido: columnas de la tabla de órdenes diarias (Singles Primer Oleada, Extras…).
model OrderWave {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  orders    DailyOrder[]
}

/// Órdenes capturadas a mano: paquetes de un cliente en una oleada de un día.
model DailyOrder {
  id        Int       @id @default(autoincrement())
  workDate  String // yyyy-mm-dd (día operativo, zona horaria de la empresa)
  clientId  Int
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  waveId    Int
  wave      OrderWave @relation(fields: [waveId], references: [id], onDelete: Cascade)
  quantity  Int       @default(0)
  updatedAt DateTime  @updatedAt

  @@unique([workDate, clientId, waveId])
  @@index([workDate])
}

/// Insumo de empaque (Bolsa A 17×30, Caja Ch…). "Sin insumo" registra los paquetes que salen sin empaque de Kurier.
model PackMaterial {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  size      String        @default("") // medidas en cm (ej. "17*30"; varias separadas por " / ")
  unitCost  Float         @default(0) // nuestro costo por pieza (sin IVA)
  unitPrice Float         @default(0) // precio de venta al cliente por pieza (sin IVA); 0 = va incluido en el servicio
  noSupply  Boolean       @default(false) // "Sin insumo" (N/A): cuenta para cuadrar contra las órdenes, no como consumo
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  supplies  DailySupply[]
}

/// Insumos usados: piezas de un material para un cliente en un día.
model DailySupply {
  id         Int          @id @default(autoincrement())
  workDate   String // yyyy-mm-dd
  clientId   Int
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  materialId Int
  material   PackMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity   Int          @default(0)
  updatedAt  DateTime     @updatedAt

  @@unique([workDate, clientId, materialId])
  @@index([workDate])
}

/// Copia en Google Drive de un documento generado. refKey: "factura:12", "cotizacion:7", "nomina:3", "ordenes:5:2026-11-16".
model DriveFile {
  id        Int       @id @default(autoincrement())
  refKey    String    @unique
  kind      String
  fileId    String    @default("")
  folderId  String    @default("")
  link      String    @default("")
  name      String    @default("")
  error     String    @default("") // último error al subir (vacío = al día)
  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([kind])
}

/// Marca comercial adicional que emite documentos (la principal es CompanySettings).
/// Los campos se llaman igual que en CompanySettings para que los PDFs los usen sin cambios.
model Brand {
  id            Int          @id @default(autoincrement())
  tradeName     String
  tagline       String       @default("")
  legalName     String       @default("")
  rfc           String       @default("")
  address       String       @default("")
  city          String       @default("")
  state         String       @default("")
  zip           String       @default("")
  phone         String       @default("")
  email         String       @default("")
  website       String       @default("")
  bankName      String       @default("")
  bankAccount   String       @default("")
  clabe         String       @default("")
  primaryColor  String       @default("#1F4E79")
  accentColor   String       @default("#ED7D31")
  logoData      Bytes?
  logoMime      String       @default("")
  quotePrefix   String       @default("") // vacío = el de la marca principal
  invoicePrefix String       @default("")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  clients       Client[]
  quotes        Quote[]
  invoices      Invoice[]
  payrolls      PayrollRun[]
}

/// Guía de última milla (CDMX). status: GENERADA | EN_RUTA | ENTREGADA | CANCELADA.
/// La zona sale de la alcaldía del CP destino; el precio, del tarifario (servicios UM-02 a UM-07) o la tarifa del cliente.
model Shipment {
  id              Int             @id @default(autoincrement())
  tracking        String          @unique // LM-XXXX-XXXX (va en la guía, el QR y el código de barras)
  reference       String          @default("") // KK-XXXX-XXXX-D
  status          String          @default("GENERADA")
  clientId        Int?
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  packageType     String          @default("CAJA") // SOBRE | CAJA
  serviceLevel    String          @default("MISMO_DIA") // MISMO_DIA | DIA_SIGUIENTE
  // Reparto: escaneo al cargar el vehículo y al entregar (con firma y foto)
  loadedAt        DateTime?
  loadedBy        String          @default("")
  attempts        Int             @default(0) // intentos de entrega fallidos
  routeSeq        Int? // orden de entrega dentro de su carga (1 = primera parada); se calcula al cerrar la carga
  loadId          Int? // carga de ruta (almacenamiento del transporte) en la que va o fue
  load            RouteLoad?      @relation(fields: [loadId], references: [id], onDelete: SetNull)
  receiverName    String          @default("") // quién recibió
  deliveredBy     String          @default("")
  proof           ShipmentProof?
  // Origen (remitente)
  originName      String
  originCompany   String          @default("")
  originEmail     String          @default("")
  originPhone     String          @default("")
  originStreet    String
  originNumber    String          @default("")
  originColony    String          @default("")
  originCity      String          @default("")
  originState     String          @default("")
  originZip       String
  originRef       String          @default("")
  originRfc       String          @default("")
  // Destino (destinatario)
  destName        String
  destCompany     String          @default("")
  destEmail       String          @default("")
  destPhone       String
  destStreet      String
  destNumber      String          @default("")
  destColony      String          @default("")
  destCity        String          @default("")
  destState       String          @default("")
  destZip         String
  destRef         String          @default("")
  destLocationUrl String          @default("") // link de ubicación que dio el cliente (Google Maps / WhatsApp)
  destLat         Float? // coordenadas del destino tomadas de ese link
  destLng         Float?
  // Ubicación aproximada de la dirección (OpenStreetMap) para ordenar la ruta cuando no hay link del cliente
  geoLat          Float?
  geoLng          Float?
  geoLevel        String          @default("") // "calle", "cp" o "ninguna" (no se encontró)
  geoKey          String          @default("") // dirección con la que se calculó (si cambia, se vuelve a calcular)
  borough         String          @default("") // alcaldía destino
  zone            Int             @default(0) // 1 o 2
  // Paquete
  content         String          @default("")
  lengthCm        Float           @default(0)
  widthCm         Float           @default(0)
  heightCm        Float           @default(0)
  weightKg        Float           @default(0)
  packages        Int             @default(1) // bultos de la parada
  cod             Float           @default(0) // pago contra entrega
  // Cobro
  price           Float           @default(0) // por parada, sin IVA
  priceLabel      String          @default("")
  route           String          @default("")
  stop            String          @default("")
  notes           String          @default("")
  createdBy       String          @default("")
  deliveredAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  events          ShipmentEvent[]

  @@index([createdAt])
  @@index([clientId, createdAt])
  @@index([loadId])
  // Índices (0036)
  @@index([status])
}

/// Bitácora de una guía: creación, correcciones de destinatario y cambios de estatus.
model ShipmentEvent {
  id         Int      @id @default(autoincrement())
  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  kind       String // CREADA | CORRECCION | ESTATUS
  detail     String   @default("")
  by         String   @default("")
  at         DateTime @default(now())

  @@index([shipmentId])
}

/// Libreta de direcciones para crear envíos. kind: ORIGEN | DESTINO.
model ShipAddress {
  id        Int      @id @default(autoincrement())
  kind      String   @default("DESTINO")
  alias     String   @default("")
  name      String
  company   String   @default("")
  email     String   @default("")
  phone     String   @default("")
  street    String
  number    String   @default("")
  colony    String   @default("")
  city      String   @default("")
  state     String   @default("")
  zip       String
  reference String   @default("")
  rfc       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

/// Bitácora: quién hizo qué y cuándo (la escribe `safe()` al terminar cada acción; ver src/lib/audit.ts).
/// Sin llave foránea al usuario: el registro se conserva aunque el usuario se elimine.
model AuditLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  userId   Int?
  userName String   @default("")
  module   String // ver ModuleId en src/lib/permissions.ts
  action   String // Creó | Modificó | Eliminó | Canceló | Reactivó | Registró pago | Exportó
  fnName   String   @default("") // acción técnica (createInvoice, addBillPayment…)
  entityId Int?
  summary  String   @default("")
  href     String   @default("")

  @@index([at])
  @@index([module, at])
  @@index([userId, at])
}

/// Estado de cuenta bancario importado (CSV del banco) para conciliar contra los movimientos.
model BankImport {
  id        Int        @id @default(autoincrement())
  name      String // cuenta o banco ("BBVA 1234")
  fileName  String     @default("")
  fromDate  DateTime?
  toDate    DateTime?
  createdBy String     @default("")
  createdAt DateTime   @default(now())
  lines     BankLine[]
}

/// Renglón del estado de cuenta: positivo = depósito, negativo = retiro.
model BankLine {
  id            Int          @id @default(autoincrement())
  importId      Int
  bankImport    BankImport   @relation(fields: [importId], references: [id], onDelete: Cascade)
  date          DateTime
  description   String       @default("")
  reference     String       @default("")
  amount        Float
  transactionId Int?         @unique // movimiento de contabilidad con el que se concilió
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  ignored       Boolean      @default(false) // no requiere movimiento (traspasos propios, etc.)

  @@index([importId])
  @@index([date])
}

/// Presupuesto mensual por categoría (ingreso o egreso) para comparar contra lo real.
model Budget {
  id       Int    @id @default(autoincrement())
  year     Int
  month    Int // 1-12
  type     String // INGRESO | EGRESO
  category String
  amount   Float

  @@unique([year, month, type, category])
}

/// Evidencia de entrega: firma (PNG) y foto (JPEG) tomadas por el repartidor al entregar.
/// Aparte de Shipment para no cargar las imágenes en listas.
model ShipmentProof {
  id            Int      @id @default(autoincrement())
  shipmentId    Int      @unique
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  signature     Bytes
  signatureMime String   @default("image/png")
  photo         Bytes
  photoMime     String   @default("image/jpeg")
  createdAt     DateTime @default(now())
}

/// Almacenamiento del transporte (jaula, caja o compartimento de la camioneta) con su código impreso.
/// El repartidor lo escanea primero y luego los paquetes que van dentro.
model StorageUnit {
  id        Int         @id @default(autoincrement())
  code      String      @unique // AL-XXXX-XXXX (va en la etiqueta: QR y código de barras)
  name      String // "Jaula 1 · NP300"
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  loads     RouteLoad[]
}

/// Carga de ruta: un repartidor llena un almacenamiento, lo cierra y sale a entregar.
/// status: CARGANDO (escaneando paquetes) | EN_REPARTO (cerrada: la app solo deja entregar) | TERMINADA
model RouteLoad {
  id         Int         @id @default(autoincrement())
  storageId  Int
  storage    StorageUnit @relation(fields: [storageId], references: [id], onDelete: Restrict)
  driverId   Int
  driverName String      @default("")
  status     String      @default("CARGANDO")
  startedAt  DateTime    @default(now())
  closedAt   DateTime?
  finishedAt DateTime?
  finishedBy String      @default("") // quién la terminó (el repartidor o un administrador)
  shipments  Shipment[]

  @@index([driverId, status])
  @@index([storageId, status])
}

/// Salida de mercancía del almacén (outbound): cajas entregadas por SKU y piezas por caja. Genera la hoja de salida en PDF.
model GoodsExit {
  id          Int             @id @default(autoincrement())
  folio       String          @unique // SAL-00001
  date        String // yyyy-mm-dd (zona horaria de la empresa)
  time        String          @default("") // hora de salida HH:MM
  clientId    Int
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  reference   String          @default("") // orden / referencia
  carrier     String          @default("") // transportista
  plates      String          @default("") // placas / unidad
  driverName  String          @default("") // conductor que recibe
  deliveredBy String          @default("") // quien entrega en almacén
  notes       String          @default("")
  createdBy   String          @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       GoodsExitItem[]

  @@index([clientId])
  @@index([date])
}

model GoodsExitItem {
  id           Int       @id @default(autoincrement())
  exitId       Int
  exit         GoodsExit @relation(fields: [exitId], references: [id], onDelete: Cascade)
  position     Int       @default(0)
  sku          String
  boxes        Int // cajas entregadas
  piecesPerBox Int // piezas por caja

  @@index([exitId])
  @@index([sku])
}
