# PostgreSQL. En Vercel la integración "Prisma Postgres" crea esta variable automáticamente.
# Para desarrollo local pega aquí la URL de tu base (Vercel → Storage → tu base → .env.local)
DATABASE_URL="postgres://usuario:password@host:5432/base?sslmode=require"

# Inicio de sesión con Google (Auth.js). Obligatorio en producción.
# 1) Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web)
#    URI de redirección autorizada: https://TU-DOMINIO/api/auth/callback/google (y http://localhost:3000/api/auth/callback/google para local)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Secreto para firmar la sesión: genera uno con  npx auth secret  (o cualquier texto aleatorio largo)
AUTH_SECRET=""
# Correo de Google de la cuenta maestra (dueño). Siempre tiene acceso y puede invitar usuarios.
ERP_OWNER_EMAIL=""

# Token para que el WMS envíe estados de cobro a /api/wms/statements (opcional).
# Genera uno largo y aleatorio; si no se define, la API queda desactivada.
WMS_API_TOKEN=
