# PostgreSQL. En Vercel la integración "Prisma Postgres" crea esta variable automáticamente.
# Para desarrollo local pega aquí la URL de tu base (Vercel → Storage → tu base → .env.local)
DATABASE_URL="postgres://usuario:password@host:5432/base?sslmode=require"

# Inicio de sesión: correo + código de una app autenticadora (Google Authenticator, Microsoft Authenticator, Authy…).
# Secreto para firmar la sesión y cifrar los autenticadores. Texto aleatorio largo. NO lo cambies después: invalidaría los autenticadores vinculados.
AUTH_SECRET=""
# Correo de la cuenta maestra (dueño).
ERP_OWNER_EMAIL=""
# Clave de instalación: la pide /configurar-acceso para vincular (o volver a vincular) el autenticador de la cuenta maestra.
ERP_SETUP_KEY=""

# Token para que el WMS envíe estados de cobro a /api/wms/statements (opcional).
# Genera uno largo y aleatorio; si no se define, la API queda desactivada.
WMS_API_TOKEN=

# Google Drive (Workspace): copia en PDF de facturas, cotizaciones, nóminas y resúmenes de órdenes (opcional).
# Cuenta de servicio con la Google Drive API activa, agregada como "Administrador de contenido" de una unidad compartida.
GOOGLE_DRIVE_CLIENT_EMAIL=
# Campo private_key del JSON de la cuenta de servicio (con los \n tal cual).
GOOGLE_DRIVE_PRIVATE_KEY=
# Id de la carpeta raíz dentro de la unidad compartida (lo que va después de /folders/ en la dirección).
GOOGLE_DRIVE_FOLDER_ID=
