# PostgreSQL. En Vercel la integración "Prisma Postgres" crea esta variable automáticamente.
# Para desarrollo local pega aquí la URL de tu base (Vercel → Storage → tu base → .env.local)
DATABASE_URL="postgres://usuario:password@host:5432/base?sslmode=require"

# Acceso al ERP (usuario y contraseña que pedirá el navegador). Obligatorio en producción.
ERP_USER="admin"
ERP_PASSWORD="cambia-esta-contraseña"
